# Dashboard en dev (npm run dev). Les variables API_PORT / API_KEY sont lues dans ../.env.
# Cible du proxy si l'API n'est pas sur localhost :
# VITE_PROXY_TARGET=http://192.168.10.1:8000
# URL du flux vidéo MJPEG publié par le script IA (ai/vision.py), affiché dans le panneau IA :
VITE_VIDEO_URL=http://localhost:8001/stream
