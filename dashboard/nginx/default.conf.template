# Dashboard SENTINEL-X : sert le build React et proxifie l'API en injectant la clé côté serveur.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Durcissement minimal
    server_tokens off;
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy no-referrer;

    # Accès au poste de supervision protégé par mot de passe (généré par bootstrap.sh)
    auth_basic "SENTINEL-X — Centre de Commandement";
    auth_basic_user_file /etc/nginx/htpasswd;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://api:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /ws {
        proxy_pass http://api:8000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}
