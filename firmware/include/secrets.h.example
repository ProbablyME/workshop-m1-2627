// Copier ce fichier en include/secrets.h (ignoré par Git) et le remplir.
// NE JAMAIS COMMITER secrets.h : le sujet impose "aucun secret ni clé en clair" dans l'archive.

#define WIFI_SSID   "SENTINEL-G1"
#define WIFI_PASS   "mot-de-passe-wifi"

#define MQTT_HOST   "192.168.10.1"     // IP du PC Serveur Local sur le réseau de table
#define MQTT_PORT   8883               // 1883 seulement pour le debug (avec TLS_ENABLED 0)
#define MQTT_USER   "sentinel"         // = MQTT_USER du .env serveur
#define MQTT_PASS   "mot-de-passe-mqtt" // = MQTT_PASSWORD du .env serveur

#define TLS_ENABLED 1

// --- Vérification du serveur, au choix ---
// Mode 1 (défaut) : empreinte SHA-1 du certificat serveur. Robuste sans NTP ni horloge.
// Valeur affichée par infra/scripts/gen-certs.sh ; à mettre à jour si le certificat change.
#define MQTT_FINGERPRINT "AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD"

// Mode 2 : validation par la CA locale (chaîne complète, plus "propre" pour le jury).
// Décommenter et coller infra/mosquitto/certs/ca.crt. L'ESP tente NTP, sinon utilise
// la date de compilation (BUILD_EPOCH) pour vérifier la validité du certificat.
