# Copier en .env et remplir. Le .env n'est JAMAIS commité.

# --- PostgreSQL ---
POSTGRES_DB=sentinelx
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me

# --- MQTT (compte utilisé par l'ESP8266, l'API et les scripts IA) ---
MQTT_USER=sentinel
MQTT_PASSWORD=change-me
MQTT_TOPIC_PREFIX=sentinel/g1

# --- API ---
# Port exposé sur le laptop (8000 par défaut ; changer si déjà pris)
API_PORT=8000
# Clé exigée dans l'en-tête X-API-Key pour les écritures externes (scripts IA, tests)
API_KEY=change-me
# Origines autorisées pour le dashboard (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:5173,http://localhost
LOG_LEVEL=INFO

# --- Dashboard (nginx) ---
DASHBOARD_PORT=8080
# Port du serveur de dev Vite (npm run dev)
DASHBOARD_DEV_PORT=5173
# Accès au poste de supervision (auth basic nginx, fichier généré par bootstrap.sh)
DASHBOARD_USER=superviseur
DASHBOARD_PASSWORD=change-me
# Flux vidéo de l'IA (ai/vision.py), tel que le navigateur du superviseur l'atteint
VIDEO_URL=http://localhost:8001/stream
# Webcam de l'IA : morceau du nom (ai/vision.py --list pour voir les noms) ou index OpenCV (0 = caméra intégrée)
VISION_CAMERA=USB
